
{
  "hosting": {
    "target": "wedding",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/divya-shreyash-wedding-invite",
        "type": 301
      },
      {
        "source": "/divya",
        "destination": "/divya-shreyash-wedding-invite",
        "type": 301
      },
      {
        "source": "/shreyash",
        "destination": "/divya-shreyash-wedding-invite",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
